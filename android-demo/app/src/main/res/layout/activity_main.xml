<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0f1a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UbuzimaFun"
            android:textSize="32sp"
            android:textColor="#7c3aed"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Education Game"
            android:textSize="14sp"
            android:textColor="#94a3b8"
            android:layout_marginBottom="24dp"/>

        <!-- Stats Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1e2235"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/xpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XP: 340 / 500"
                    android:textSize="16sp"
                    android:textColor="#e2e8f0"
                    android:layout_marginBottom="8dp"/>

                <ProgressBar
                    android:id="@+id/xpProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="68"
                    android:progressTint="#7c3aed"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/coinsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🪙 120 coins"
                        android:textSize="14sp"
                        android:textColor="#94a3b8"/>

                    <TextView
                        android:id="@+id/levelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 4"
                        android:textSize="14sp"
                        android:textColor="#94a3b8"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Current World Title -->
        <TextView
            android:id="@+id/worldTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️ Adventure Map"
            android:textSize="20sp"
            android:textColor="#06b6d4"
            android:layout_marginBottom="16dp"/>

        <!-- World 1 Button -->
        <Button
            android:id="@+id/btnWorld1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏰 Reproductive Realm\n✔ Done"
            android:textSize="16sp"
            android:backgroundTint="#7c3aed"
            android:layout_marginBottom="12dp"
            android:padding="16dp"/>

        <!-- World 2 Button -->
        <Button
            android:id="@+id/btnWorld2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ Cleanliness Crusade\n▶ Active"
            android:textSize="16sp"
            android:backgroundTint="#f59e0b"
            android:layout_marginBottom="12dp"
            android:padding="16dp"/>

        <!-- World 3 Button -->
        <Button
            android:id="@+id/btnWorld3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Nutrition Nexus\n🔒 Locked"
            android:textSize="16sp"
            android:backgroundTint="#2d3555"
            android:layout_marginBottom="24dp"
            android:padding="16dp"/>

        <!-- Start Quest Button -->
        <Button
            android:id="@+id/btnStartQuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ Start Quest"
            android:textSize="18sp"
            android:backgroundTint="#10b981"
            android:padding="20dp"/>

    </LinearLayout>
</ScrollView>
